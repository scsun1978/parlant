[
  {"id": "S01", "theme": "指代-行李", "turns": [
    {"q": "随身行李限几件？", "expect": ["件", "随身|手提"]},
    {"q": "那婴儿票呢", "expect": ["婴儿|儿童"]}
  ]},
  {"id": "S02", "theme": "反悔-退改", "turns": [
    {"q": "我要退票", "expect": ["退票|退"]},
    {"q": "算了不退了，改签到后天", "expect": ["改签"]}
  ]},
  {"id": "S03", "theme": "插话-多意图", "turns": [
    {"q": "先帮我看看行李超重怎么办", "expect": ["超重|行李"]},
    {"q": "对了充电宝能带吗", "expect": ["充电宝|Wh|额定能量"]},
    {"q": "回到刚才，超重行李怎么收费", "expect": ["超重|行李"]}
  ]},
  {"id": "S04", "theme": "上下文日期", "turns": [
    {"q": "查明天飞北京的航班", "expect": ["北京|航班"]},
    {"q": "就按我刚才说的日期，查飞广州的", "expect": ["广州"]}
  ]},
  {"id": "S05", "theme": "跳题-失物到投诉", "turns": [
    {"q": "我钱包丢了", "expect": ["失物|拾获|丢"]},
    {"q": "你们这服务太差了我要投诉", "expect": ["96990|投诉|抱歉|歉意|理解"]},
    {"q": "还是先帮我找钱包吧", "expect": ["钱包|失物|拾获"]}
  ]},
  {"id": "S06", "theme": "指代-设施", "turns": [
    {"q": "T2 有母婴室吗", "expect": ["母婴"]},
    {"q": "那 S1 呢", "expect": ["S1|卫星厅"]}
  ]},
  {"id": "S07", "theme": "上下文航班号", "turns": [
    {"q": "CA8322 今天几点起飞", "expect": ["CA8322"]},
    {"q": "它的登机口在哪", "expect": ["登机口|[A-Z]\\d+"]},
    {"q": "从这个登机口怎么去地铁站", "expect": ["地铁|2\\s*号线"]}
  ]},
  {"id": "S08", "theme": "反悔-交通", "turns": [
    {"q": "去市区坐磁悬浮快吗", "expect": ["磁悬浮|磁浮"]},
    {"q": "太贵了，换地铁怎么坐", "expect": ["地铁|2\\s*号线"]}
  ]},
  {"id": "S09", "theme": "连续追问-特殊旅客", "turns": [
    {"q": "孕妇能坐飞机吗", "expect": ["孕妇|航司|航空"]},
    {"q": "需要开证明吗", "expect": ["证明|航司|航空|孕周"]},
    {"q": "那轮椅服务呢", "expect": ["轮椅"]}
  ]},
  {"id": "S10", "theme": "边界-无关插入", "turns": [
    {"q": "帮我写一首诗", "expect": ["机场|出行|客服|无法|只能"]},
    {"q": "还是说说安检能带什么吧", "expect": ["安检|携带|违禁|禁止"]}
  ]},
  {"id": "S11", "theme": "多轮澄清", "turns": [
    {"q": "我要改签", "expect": ["改签"]},
    {"q": "CA8322", "expect": ["CA8322|改签|哪天|日期"]},
    {"q": "改到后天", "expect": ["改签|航司|航空|平台"]}
  ]},
  {"id": "S12", "theme": "指代-液态物品", "turns": [
    {"q": "液体能带多少上飞机", "expect": ["100|毫升|ml"]},
    {"q": "那化妆品呢", "expect": ["化妆|液态|100|毫升"]}
  ]},
  {"id": "S13", "theme": "上下文-停车接驳", "turns": [
    {"q": "P4 停车场怎么收费", "expect": ["P4|停车"]},
    {"q": "从那里到 T2 远吗", "expect": ["T2|P4|接驳|摆渡|距离"]}
  ]},
  {"id": "S14", "theme": "纠错-错字", "turns": [
    {"q": "直机要提前多久", "expect": ["小时|提前"]},
    {"q": "我是说值机", "expect": ["值机|小时|提前"]}
  ]},
  {"id": "S15", "theme": "跳题-政策到航班", "turns": [
    {"q": "打火机能带吗", "expect": ["打火机|禁止|不能"]},
    {"q": "帮我查下 CA8322 今天状态", "expect": ["CA8322"]},
    {"q": "它的登机口远不远", "expect": ["登机口|[A-Z]\\d+|T1|T2|S1|S2"]}
  ]}
]
